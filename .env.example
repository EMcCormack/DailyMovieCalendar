# Public app configuration. Physical phones need your computer's LAN IP locally.
EXPO_PUBLIC_MOVIE_API_URL=http://localhost:3001
# Local server/seed only. AWS Lambda reads this token from SSM Parameter Store.
TMDB_READ_TOKEN=
ALLOWED_ORIGIN=http://localhost:8081
PORT=3001
# Optional locally: omit COLLECTIONS_TABLE to serve fixture collections.
AWS_REGION=us-east-1
COLLECTIONS_TABLE=
TMDB_TOKEN_PARAMETER=/daily-movie-calendar/tmdb-token
